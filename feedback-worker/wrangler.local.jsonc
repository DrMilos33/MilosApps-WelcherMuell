{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "milosapps-waste-guide-feedback-local",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ENVIRONMENT": "DEV",
    "PRODUCTION_APPROVED": "false",
    "ALLOWED_RESULT_BASES": "http://127.0.0.1:4318/"
  },
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "milosapps-waste-guide-feedback-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
